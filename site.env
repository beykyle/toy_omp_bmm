# Cluster-specific settings.  THIS IS THE ONLY FILE YOU SHOULD NEED TO EDIT to run this
# study somewhere other than the machine it was developed on (MSU ICER / HPCC).
#
# It is a plain KEY=value file so that both the shell scripts (`source site.env`) and the
# Python builder (chuq_io.load_site_config) read the same definitions.
# Keep it shell-safe: no spaces around `=`, quote values containing spaces.

# --- SLURM ----------------------------------------------------------------------------
# Charge account, i.e. `sbatch -A`.  Leave empty if your site does not use accounts;
# the generated scripts then omit the directive.
ACCOUNT=frib-nodes

# Partition for the short jobs (notebook execution, JupyterLab).
PARTITION=general

# Partition for the long MPI sampling jobs (36 h by default -- must allow WALLTIME below).
PARTITION_LONG=general-long

# Sampling job geometry.  NTASKS is 1 schwimmbad master + (NTASKS-1) likelihood workers,
# so the useful parallelism is NTASKS-1.  Total memory requested is NTASKS x MEM_PER_CPU.
NTASKS=65
MEM_PER_CPU=6G
WALLTIME=36:00:00

# Resources for the headless notebook-execution job (run_analysis.slurm).
ANALYSIS_CPUS=8
ANALYSIS_MEM=32G
ANALYSIS_WALLTIME=02:00:00

# --- MPI ------------------------------------------------------------------------------
# Environment module providing MPI.  Leave EMPTY to use whatever MPI is already on PATH
# (a system install, a conda package, or a site default) -- that is the right setting on
# any machine without Lmod/environment-modules.
MPI_MODULE=OpenMPI/4.1.5-GCC-12.3.0

# How to launch the MPI ranks.  `mpiexec` works for OpenMPI+PMIx under SLURM.  Many sites
# require srun instead:
#     MPI_LAUNCHER='srun --mpi=pmi2'
# The launcher must start exactly NTASKS ranks.
#
# SINGLE quotes matter: $SLURM_NTASKS must survive as literal text into the generated job
# script, where SLURM defines it at runtime.  Double quotes would make the shell expand it to
# nothing when this file is sourced.
MPI_LAUNCHER='mpiexec -n $SLURM_NTASKS'
