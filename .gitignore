# --- environment / caches -------------------------------------------------
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ipynb_checkpoints/
.claude/settings.local.json

# --- job logs written into the project root -------------------------------
analysis-*.SLURMout
jupyter-*.log

# --- generated calibration artifacts --------------------------------------
# What IS committed for each run: dynesty_idata.nc (posterior samples),
# dynesty_results.npz (evidence / diagnostics), the dynesty-*.SLURMout log,
# and calibrations/fit_info.json.  That is everything the analysis notebooks
# read, so a clone reproduces every figure without re-sampling.
#
# What is NOT committed, and why:
#   config.pkl              ~42 MB   regenerated by `python build_configs.py`
#   dynesty_checkpoint.pkl  ~55 MB   sampler resume state, no scientific content
#   dynesty_history.h5     ~125 MB   raw live-point history; over GitHub's
#                                    100 MiB hard limit, and the posteriors in
#                                    dynesty_idata.nc supersede it
#   dynesty.slurm                    rendered from dynesty.slurm.template +
#                                    site.env, and holds machine-specific paths
calibrations/*/config.pkl
calibrations/*/dynesty_checkpoint.pkl
calibrations/*/dynesty_history.h5
calibrations/*/dynesty.slurm
